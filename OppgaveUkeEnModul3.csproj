<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

<ItemGroup>
  <Compile Remove="ConsoleApp/**/*.cs" />
  <Compile Remove="Calculator/**/*.cs" />
  <Content Remove="ConsoleApp\**;Calculator.Tests\**" />
  <Compile Remove="Calculator.Tests/**/*.cs" />
  <Compile Remove="Core/Interfaces/CalculateXP.cs" />
  <Compile Remove="Core/Models/Character.cs" />
  <Compile Remove="Core/Models/Monsters.cs" />
  <Compile Remove="Core/Models/Swords.cs" />
</ItemGroup>
</Project>
